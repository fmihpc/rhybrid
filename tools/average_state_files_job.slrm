#!/bin/bash -l
#SBATCH --job-name=rhba
#SBATCH --account=YOUR_PROJECT_HERE
#SBATCH --time=01:00:00
#SBATCH --partition=YOUR_QUEUE_HERE
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=6
#SBATCH --mem=300G
#SBATCH --no-requeue
#SBATCH --output=slurm-%j.out
set -Eeuo pipefail
trap 'echo "SCRIPT ERROR: line $LINENO: $BASH_COMMAND (exit status $?)" >&2' ERR
on_exit() {
    local status=$?
    local elapsed=$SECONDS
    echo
    if (( status == 0 )); then
        echo "(SLURM) FINISH: ${script_name:-${SLURM_JOB_NAME:-unknown}}"
    else
        echo "(SLURM) FAILED: ${script_name:-${SLURM_JOB_NAME:-unknown}} (exit status $status)" >&2
    fi
    echo
    echo "Time stamp: $(date -R)"
    printf 'Elapsed time: %02d:%02d:%02d\n' "$((elapsed / 3600))" "$(((elapsed % 3600) / 60))" "$((elapsed % 60))"
    echo
}
trap on_exit EXIT
SECONDS=0
cd "$SLURM_SUBMIT_DIR"
echo "$SLURM_JOB_ID" >jobid.txt
N_nodes="${SLURM_JOB_NUM_NODES}"
N_tasks="${SLURM_NTASKS}"
N_cpus_per_task="${SLURM_CPUS_PER_TASK}"
# Get original submitted script path.
if job_info=$(scontrol show job "$SLURM_JOB_ID" 2>/dev/null); then
    script_path=$(sed -n 's/^[[:space:]]*Command=//p' <<< "$job_info")
else
    script_path=""
fi
script_name="${script_path##*/}"
# Fallback if path is unavailable.
script_name="${script_name:-$SLURM_JOB_NAME}"
script_path="${script_path:-unknown}"
echo
echo "Time stamp: $(date -R)"
echo
echo "Script name: $script_name"
echo "Script path: $script_path"
echo
echo "(SLURM) START: $script_name"
echo
echo "Current folder: $(pwd)"
echo
echo "N_nodes = $N_nodes"
echo "N_tasks = $N_tasks"
echo "N_cpus_per_task = $N_cpus_per_task"
echo
echo "Job ID: $SLURM_JOB_ID"
echo "Node list: $SLURM_JOB_NODELIST"
echo
if (( N_nodes != 1 || N_tasks != 1 )); then
    echo "ERROR: This script requires exactly one Slurm node and one task." >&2
    exit 1
fi
if (( N_cpus_per_task < 1 )); then
    echo "ERROR: Invalid CPU allocation." >&2
    exit 1
fi

module load StdEnv
#module load gcc/15.2.0
#module load boost
#module load openmpi/5.0.10
module load python-data/3.12-31.03
#module load gnuplot/6.0.0
#module load texlive/20260301
#module load ffmpeg

folder_vlsv_files="./"
folder_output="./"
folder_rhybridpy="/PATH/TO/RHYBRIDPY/"

timestep_first_text="0"
timestep_last_text="4000"
timestep_stride_text="1"
output_file="${folder_output%/}/average_state_${timestep_first_text}_${timestep_last_text}_${timestep_stride_text}dt.vlsv"

state_number_width=8
WORK_DIR="$SLURM_SUBMIT_DIR/average_state_files_tmp_${SLURM_JOB_ID}"
averaging_script="./average_state_files.py"

echo "Reading VLSV files from: $folder_vlsv_files"

export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$folder_rhybridpy"
mkdir -p "$folder_output"

# Prevent unintended multithreading in linked libraries
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

# Average selected files using parallel workers
for value in \
    "$timestep_first_text" \
    "$timestep_last_text" \
    "$timestep_stride_text"
do
    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        echo "ERROR: invalid timestep value: $value" >&2
        exit 1
    fi
done

timestep_first=$((10#$timestep_first_text))
timestep_last=$((10#$timestep_last_text))
timestep_stride=$((10#$timestep_stride_text))

if (( timestep_stride < 1 || timestep_first > timestep_last )); then
    echo "ERROR: invalid timestep range or stride" >&2
    exit 1
fi
if (( state_number_width < 1 )); then
    echo "ERROR: state_number_width must be at least 1" >&2
    exit 1
fi
if [[ ! -f "$averaging_script" ]]; then
    echo "ERROR: averaging script not found: $averaging_script" >&2
    exit 1
fi
# Refuse to overwrite an existing output, including dangling symlinks.
if [[ -e "$output_file" || -L "$output_file" ]]; then
    echo "ERROR: output already exists: $output_file" >&2
    exit 1
fi
if [[ "$folder_vlsv_files" != "/" ]]; then
    folder_vlsv_files="${folder_vlsv_files%/}"
fi

mkdir -p "$WORK_DIR"
input_list_file="$WORK_DIR/input_files_${SLURM_JOB_ID:-$$}.txt"
cleanup() {
    if [[ -f "$input_list_file" ]]; then
        unlink "$input_list_file" || true
    fi
    rmdir "$WORK_DIR" 2>/dev/null || true
}
# Report the original exit status first, then clean up temporary files.
# Without an explicit exit, Bash retains the status that triggered this trap.
trap 'on_exit; cleanup' EXIT

input_files=()
missing_files=()
candidate_count=0
for ((n=timestep_first; n<=timestep_last; n+=timestep_stride)); do
    ((candidate_count += 1))
    printf -v file '%s/state%0*d.vlsv' \
        "$folder_vlsv_files" "$state_number_width" "$n"
    if [[ -f "$file" ]]; then
        input_files+=("$file")
    else
        missing_files+=("$file")
    fi
done

if (( ${#input_files[@]} == 0 )); then
    echo "ERROR: none of the $candidate_count suggested VLSV files were found" >&2
    exit 1
fi

echo "Suggested files: $candidate_count"
echo "Found files:     ${#input_files[@]}"
echo "Missing files:   ${#missing_files[@]}"
echo "First input:     ${input_files[0]}"
echo "Last input:      ${input_files[-1]}"
echo "Average file:    $output_file"

# Avoid the operating-system argument-size limit for large snapshot sets.
# Bash printf is a builtin, so writing thousands of array entries here does
# not itself invoke a command with thousands of arguments.
printf '%s\n' "${input_files[@]}" > "$input_list_file"

# These small context values let average_state_files.py include the suggested
# range and complete Slurm launch in the human-readable provenance log.
export AVERAGE_STATE_TIMESTEP_FIRST="$timestep_first"
export AVERAGE_STATE_TIMESTEP_LAST="$timestep_last"
export AVERAGE_STATE_TIMESTEP_STRIDE="$timestep_stride"
export AVERAGE_STATE_NUMBER_WIDTH="$state_number_width"
export AVERAGE_STATE_INPUT_FOLDER="$folder_vlsv_files"
export AVERAGE_STATE_LAUNCH_PREFIX="srun --ntasks=1 --cpus-per-task=$N_cpus_per_task --cpu-bind=cores python -u"

average_command=(
    srun
    --ntasks=1
    --cpus-per-task="$N_cpus_per_task"
    --cpu-bind=cores
    python
    -u
    "$averaging_script"
    --strategy streaming
    --workers "$N_cpus_per_task"
    --chunk-cells 1000000
    --work-dir "$WORK_DIR"
    -o "$output_file"
    --input-list "$input_list_file"
)

echo "AVERAGING: BEGIN"
"${average_command[@]}"
echo "AVERAGING: FINISHED"

echo "Output file: $output_file"
echo "Provenance log: ${output_file}.log"


